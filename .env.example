# Bloggen runtime configuration
BLOGGEN_APP__NAME=Bloggen
BLOGGEN_APP__ENVIRONMENT=development
BLOGGEN_APP__DEBUG=false
BLOGGEN_LOGGING__LEVEL=INFO
BLOGGEN_LOGGING__LOG_DIRECTORY=data/logs
BLOGGEN_LOGGING__ERROR_FILE=errors.log
BLOGGEN_LOGGING__DEBUG_FILE=debug.log
BLOGGEN_LOGGING__RETENTION=14 days
BLOGGEN_HTTP__BASE_URL=
BLOGGEN_HTTP__TIMEOUT_SECONDS=30
BLOGGEN_HTTP__MAX_RETRIES=3

# OpenRouter credentials are secrets and should never be committed.
OPENROUTER_API_KEY=
